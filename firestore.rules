rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // हे app स्वतःची password-system client-side सांभाळतं (Firebase Auth वापरत नाही),
    // त्यामुळे इथे "mandal" collection वर सगळ्यांना वाचन/लेखन दिलं आहे —
    // security ही तुमच्या account passwords वर अवलंबून आहे, Firestore rules वर नाही.
    // जास्त कडक हवं असेल तर हे बदलून खरं Firebase Authentication जोडावं लागेल.
    match /mandal/{document} {
      allow read, write: if true;
    }
  }
}
